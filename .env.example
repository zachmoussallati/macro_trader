# ====================================================================
# Macro Trader — environment variables
# Copy to `.env` (never committed) and fill with real values.
# ====================================================================

# ---------- Application ----------
APP_ENV=dev                            # one of: dev, test, prod
APP_LOG_LEVEL=INFO                     # DEBUG, INFO, WARNING, ERROR
APP_LOG_FORMAT=console                 # console (pretty) or json

# ---------- Database (Postgres + TimescaleDB) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=macro_trader
POSTGRES_USER=macro
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_TEST_DB=macro_trader_test

# Combined URL — derived from the above by default. Override only if
# pointing at an external Postgres (e.g. cloud or Docker network).
DATABASE_URL=postgresql+psycopg://macro:change_me_dev_password@localhost:5432/macro_trader

# ---------- pgAdmin ----------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_dev_password
PGADMIN_PORT=5050

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
# Comma-separated list of allowed CORS origins.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Auth ----------
JWT_SECRET_KEY=replace_me_with_64_random_chars_minimum_length_required_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# Seed admin credentials — created on first DB seed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_dev_admin_password

# ---------- Dagster ----------
DAGSTER_HOME=./dagster_home
DAGSTER_PORT=3000

# ---------- Frontend ----------
VITE_API_URL=http://localhost:8000/api/v1

# ---------- Claude API (used in Stage 10+) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7

# ---------- External data sources (placeholders for Stage 2+) ----------
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
QUANDL_API_KEY=
